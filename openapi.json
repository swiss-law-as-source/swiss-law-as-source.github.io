{
  "openapi": "3.1.0",
  "info": {
    "title": "Swiss Law Collection API",
    "version": "1.0.0",
    "description": "Static JSON API for 30,000+ unique Swiss federal and cantonal laws, served from GitHub Pages. All endpoints are read-only GET, no authentication, no rate limits.\n\n**Raw law files**: every law is a Markdown file with YAML frontmatter at `https://raw.githubusercontent.com/benjamin-arfa/swiss-law/main/{path}` using the `path` values returned by these endpoints (URL-encode the path).\n\n**Counts are deduplicated**: one law counts once regardless of its language versions; `total_files` carries the raw file count.\n\n**Categories are harmonized**: aggregation keys use canonical German labels / dotted tree codes; join `/api/v1/categories/*` to localize (de/fr/it, types also en). One taxonomy (LexFind 'domaine juridique') spans federal and cantonal law.\n\n**Article counts are heuristic**: distinct 'Art. N' / 'Article N' / 'Articolo N' / line-leading '§ N' markers per file; cross-references inflate slightly, metadata-only pages count 0.\n\nInteractive dashboard: https://swiss-law-as-source.github.io/"
  },
  "servers": [
    {
      "url": "https://swiss-law-as-source.github.io"
    }
  ],
  "tags": [
    {
      "name": "publications",
      "description": "Laws grouped by entry-into-force year"
    },
    {
      "name": "statistics",
      "description": "Aggregate and per-year/per-canton statistics"
    },
    {
      "name": "laws",
      "description": "Per-entity law index with languages, text volume, article counts"
    },
    {
      "name": "categories",
      "description": "Harmonized category dictionaries (multilingual)"
    },
    {
      "name": "quality",
      "description": "Coverage and completeness reports"
    },
    {
      "name": "global",
      "description": "Whole-dataset files"
    },
    {
      "name": "data-exports",
      "description": "Static CSV and SDMX exports (see /data.html)"
    }
  ],
  "paths": {
    "/stats.json": {
      "get": {
        "tags": [
          "global"
        ],
        "summary": "Aggregate statistics (deduplicated counts)",
        "description": "total_laws, breakdowns by canton/type/category/year, harmonized-domain summary (by_harmonized_domain), category_type_labels translations, cross-tabs.",
        "responses": {
          "200": {
            "description": "Statistics object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/laws.json": {
      "get": {
        "tags": [
          "global"
        ],
        "summary": "Search index — one entry per unique law",
        "description": "Array of {sr, title, path, cat, scope, canton?, languages}. Powers the search page.",
        "responses": {
          "200": {
            "description": "Law array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/publications/index.json": {
      "get": {
        "tags": [
          "publications"
        ],
        "summary": "Publication years index",
        "responses": {
          "200": {
            "description": "years, total_publications, earliest_year, latest_year",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/publications/{year}.json": {
      "get": {
        "tags": [
          "publications"
        ],
        "summary": "All laws that entered into force in a year",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 2024
          }
        ],
        "responses": {
          "200": {
            "description": "date_prefix, count, publications[] with languages array and category fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/index.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Available years and entities for per-year stats",
        "responses": {
          "200": {
            "description": "years, entities, total_files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/{year}/{entity}.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Stats for one year and entity (CH or canton code)",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2024"
          },
          {
            "name": "entity",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "BE"
          }
        ],
        "responses": {
          "200": {
            "description": "total, by_type (canonical labels), topic trees, languages_available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/concordats_by_domain.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Intercantonal agreements per canton per thematic domain",
        "responses": {
          "200": {
            "description": "domains, cantons{...}, totals, notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "description": "Counting unit: canton memberships, not distinct treaties — each agreement counts once per signatory canton whose collection publishes it (a 26-canton concordat counts 26), matching the chstat.ch methodology. The response shape is frozen (additive changes only). For distinct agreements with their signing cantons see /api/v1/stats/concordats_signatories.json."
      }
    },
    "/api/v1/stats/concordats_chstat_comparison.json": {
      "get": {
        "tags": [
          "quality"
        ],
        "summary": "Verification: concordats enacted <= 2003 vs chstat.ch's 2003 table",
        "description": "Per canton: chstat 2003 domain counts (frozen reference, Institute of Federalism) vs our concordats ENACTED on or before 2003 and still in force. Year = original enactment date (laws are law+version pairs).",
        "responses": {
          "200": {
            "description": "chstat_total, ours totals, per-canton rows with deltas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/harmonized_categories.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "ALL laws (federal + cantonal) on one harmonized taxonomy",
        "description": "LexFind global systematics tree annotated with {total, federal, cantonal} per node; top_level summary; mapping provenance counts.",
        "responses": {
          "200": {
            "description": "note, counts, top_level[], tree[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/laws/index.json": {
      "get": {
        "tags": [
          "laws"
        ],
        "summary": "Law-index master: entities with counts and volumes",
        "responses": {
          "200": {
            "description": "total_laws, link_base, entities{code: {name, laws, total_chars, total_articles, file}}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/laws/{entity}.json": {
      "get": {
        "tags": [
          "laws"
        ],
        "summary": "One entity's laws with per-language chars/articles",
        "parameters": [
          {
            "name": "entity",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "CH",
                "AG",
                "AI",
                "AR",
                "BE",
                "BL",
                "BS",
                "FR",
                "GE",
                "GL",
                "GR",
                "JU",
                "LU",
                "NE",
                "NW",
                "OW",
                "SG",
                "SH",
                "SO",
                "SZ",
                "TG",
                "TI",
                "UR",
                "VD",
                "VS",
                "ZG",
                "ZH"
              ]
            },
            "example": "GR"
          }
        ],
        "responses": {
          "200": {
            "description": "items[] with {id, title, link, languages: {lang: {chars, articles, path}}, category fields}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/index.json": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "Available category dictionaries",
        "responses": {
          "200": {
            "description": "types, global, cantons{...}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/types.json": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "Instrument types with labels in de/fr/it",
        "description": "LexFind category ids are language-stable; stats keys use the German label.",
        "responses": {
          "200": {
            "description": "types: [{id, label: {de, fr, it}}]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/global.json": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "Harmonized taxonomy tree (domaine juridique), multilingual",
        "responses": {
          "200": {
            "description": "tree: [{identifier, title: {de, fr, it}, children}]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/{canton}.json": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "One canton's systematics tree (primary language)",
        "parameters": [
          {
            "name": "canton",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "BS"
          }
        ],
        "responses": {
          "200": {
            "description": "canton, tree[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/coverage.json": {
      "get": {
        "tags": [
          "quality"
        ],
        "summary": "Completeness audit vs LexFind/Fedlex catalogs",
        "description": "Per canton × instrument type: catalog/present/missing; federal SRs vs Fedlex.",
        "responses": {
          "200": {
            "description": "note, cantons{XX: {by_type, missing}}, federal, total_missing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/concordats_signatories.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Distinct intercantonal agreements with their signing cantons",
        "responses": {
          "200": {
            "description": "total_agreements, agreements[{title, domain, year, n_signatories, signatories[], per_canton{...}}], notes. Signatories are the cantons whose collections publish the text (LexFind has no official member lists).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/harmonized_by_year.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Per-enactment-year counts on the harmonized taxonomy (depth <= 2)",
        "responses": {
          "200": {
            "description": "years{YYYY: {code: [federal, cantonal]}}, unknown{code: [federal, cantonal]} for undated laws. Titles: join /api/v1/categories/global.json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/types/index.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Available per-instrument-type canton x domain cross-tabs",
        "responses": {
          "200": {
            "description": "types[{slug, label{de,fr,it,en}, total, path}], ordered by total desc.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/types/{type}_by_domain.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Cantonal acts of one instrument type per canton per thematic domain",
        "description": "Same shape as /api/v1/stats/concordats_by_domain.json (domains, cantons, totals, by_year), plus a type{slug, label} object. For the intercantonal type the counting unit is canton memberships.",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "staatsvertrag",
                "interkantonale_vereinbarung",
                "verfassung",
                "gesetz",
                "anderes",
                "verordnung",
                "reglement",
                "dekret",
                "gemeindeerlass"
              ]
            },
            "description": "Instrument-type slug (see /api/v1/stats/types/index.json)"
          }
        ],
        "responses": {
          "200": {
            "description": "domains, cantons{...}, totals, by_year, type{slug, label}, notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/concordats_by_domain_signatories.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Concordats per canton per domain — signatory-canton counting (chstat/BADAC 2003 methodology)",
        "description": "Each agreement counts once per signatory canton (an agreement signed by 10 cantons counts 10). Signatory sets are estimated per agreement: cantons publishing the text in their collections, union cantons named in any language version's title. Same shape as concordats_by_domain.json, plus total_memberships, total_agreements, memberships_until_2003 (validation vs chstat_2003_reference = 2522) and memberships_added_by_title_evidence.",
        "responses": {
          "200": {
            "description": "domains, cantons{...}, totals, by_year, memberships_until_2003, notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/concordats_by_domain_extrapolated.json": {
      "get": {
        "tags": [
          "statistics"
        ],
        "summary": "Cumulative concordat memberships since 1848 — chstat 2003 baseline + post-2003 data",
        "description": "chstat/BADAC counting (one count per signatory canton). All cells are computed from the collection's signatory-weighted series; cells <= 2003 are calibrated per canton (largest-remainder) so canton totals equal chstat's published 2003 figures (2,522 overall) while the domain and year structure stays computed. Post-2003 cells are unscaled. Includes a 'calibration' block (targets, our counts, factors). Same shape as concordats_by_domain.json.",
        "responses": {
          "200": {
            "description": "domains, cantons{...}, totals, by_year, baseline_memberships_2003, post_2003_memberships, notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csv/index.json": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "List of available CSV exports",
        "responses": {
          "200": {
            "description": "files[{file, rows, description}]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csv/{type}_canton_year.csv": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "One instrument type: all cantons x all years x legal domains",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "staatsvertrag",
                "interkantonale_vereinbarung",
                "verfassung",
                "gesetz",
                "anderes",
                "verordnung",
                "reglement",
                "dekret",
                "gemeindeerlass"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "canton,year,<domains>,total",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csv/laws_cube.csv": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "Everything: all types x cantons x years x domains (long format)",
        "responses": {
          "200": {
            "description": "instrument_type,canton,year,domain,count",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csv/concordats_memberships_since_1848.csv": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "Concordat memberships since 1848 (chstat methodology)",
        "responses": {
          "200": {
            "description": "canton,year,<domains>,total; the 1848-2003 chstat baseline is one block at year 2003",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdmx/structures.xml": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "SDMX-ML 2.1 structural artefacts (agency SLC)",
        "responses": {
          "200": {
            "description": "Codelists CL_CANTON/CL_DOMAIN/CL_INSTRUMENT_TYPE, concept scheme CS_SLC, DSD_LAWS, DSD_CONCORDATS, dataflows DF_LAWS, DF_CONCORDATS",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdmx/data/{flow}.sdmx.csv": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "Dataflow content as SDMX-CSV 1.0",
        "parameters": [
          {
            "name": "flow",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "df_laws",
                "df_concordats"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DATAFLOW,<dims>,TIME_PERIOD,OBS_VALUE",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdmx/data/{flow}.xml": {
      "get": {
        "tags": [
          "data-exports"
        ],
        "summary": "Dataflow content as SDMX-ML 2.1 GenericData",
        "parameters": [
          {
            "name": "flow",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "df_laws",
                "df_concordats"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GenericData message",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quality/undated_laws.json": {
      "get": {
        "tags": [
          "quality"
        ],
        "summary": "Review list of laws excluded from year-based statistics",
        "description": "Every law with no plausible enactment evidence: 'no_date' (no date fields) or 'implausible_date' (only sentinel/typo values before 1400, e.g. LexFind's 1000-01-01 placeholder). Raw upstream values kept in raw_dates. Browsable at /undated.html.",
        "responses": {
          "200": {
            "description": "total, by_entity, by_reason, laws[]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
